# Copie para .env e ajuste se necessário. Tudo funciona localmente com os padrões
# abaixo (mocks), sem nenhuma credencial real.

# --- API ---
PORT=3000
DATABASE_URL=postgresql://gavve:gavve@localhost:5432/gavve_dev

# --- Auth (Firebase) ---
# emulator (padrão, local) | live (produção, precisa de credenciais reais)
AUTH_MODE=emulator
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GCLOUD_PROJECT=demo-gavve

# --- Storage ---
# local (padrão, disco em apps/api/uploads) | gcs (Google Cloud Storage)
STORAGE_PROVIDER=local
GCS_BUCKET=

# --- IA (extração de PDFs e assistente de relatórios) ---
# mock (padrão, respostas determinísticas) | gemini (precisa de GEMINI_API_KEY)
LLM_PROVIDER=mock
GEMINI_API_KEY=

# --- Integração LBS/SAP (sempre simulada neste MVP) ---
LBS_PROVIDER=mock

# --- Front-end (Vite) ---
VITE_API_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-gavve.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-gavve
VITE_USE_AUTH_EMULATOR=true
